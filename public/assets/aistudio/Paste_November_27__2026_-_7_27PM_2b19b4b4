۴. مایگریشن آماده MySQL (database/migrations/017_question_bank.sql)
مایگریشن زیر دقیقاً مطابق قراردادهای famoapi_ai (بعد از 016_admin_2fa_challenges.sql، موتور InnoDB، کاراکترست utf8mb4_unicode_ci، کلید اصلی BIGINT UNSIGNED، تاریخ‌های UTC و ایندکس‌های نام‌گذاری‌شده uq_* / idx_*) طراحی شده است.

-- Migration 017: Lernito Question Bank (Shelves, Questions, Shelf-Question Mapping)
-- Compatible with MySQL 8.0+ / 8.4+
-- Phase 1: Shelves + Questions + Shelf mapping
-- Phase 2 ready: Nullable answer_key_json, answer_html, answer_synced_at on lernito_questions

CREATE TABLE IF NOT EXISTS lernito_shelves (
  id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
  lernito_id VARCHAR(64) NOT NULL,
  name VARCHAR(255) NOT NULL DEFAULT '',
  color VARCHAR(32) DEFAULT NULL,
  creator_id VARCHAR(64) DEFAULT NULL,
  record_count INT UNSIGNED NOT NULL DEFAULT 0,
  lernito_created_at DATETIME DEFAULT NULL,
  lernito_modified_at DATETIME DEFAULT NULL,
  last_synced_at DATETIME NOT NULL,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (id),
  UNIQUE KEY uq_lernito_shelves_lernito_id (lernito_id),
  KEY idx_lernito_shelves_modified (lernito_modified_at),
  KEY idx_lernito_shelves_name (name(100))
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE IF NOT EXISTS lernito_questions (
  id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
  lernito_id VARCHAR(64) NOT NULL,
  question_type VARCHAR(32) NOT NULL DEFAULT 'unknown', -- 'multipleChoice' | 'description' | 'multipart' | ...
  is_multipart TINYINT(1) NOT NULL DEFAULT 0,
  part_count SMALLINT UNSIGNED NOT NULL DEFAULT 1,
  difficulty TINYINT UNSIGNED DEFAULT NULL,
  question_html MEDIUMTEXT NOT NULL,
  choices_json JSON DEFAULT NULL,          -- آرایه گزینه‌ها برای سوالات تک‌بخشی (ممکن است 2، 4 یا بیشتر باشد)
  sub_questions_json JSON DEFAULT NULL,    -- آرایه کامل subQuestions برای سوالات چندبخشی
  topics_json JSON DEFAULT NULL,           -- آرایه کامل topics (برای فیلتر دقیق در آینده)
  references_json JSON DEFAULT NULL,       -- منبع سوال (آزمون/تالیفی/امتحان نهایی)
  flags_json JSON DEFAULT NULL,            -- { isBuggy, hasBugReport }
  -- فیلدهای نرمال‌شده از اولین topic (برای جستجو و فیلتر سریع SQL بدون اسکن JSON)
  primary_segment VARCHAR(64) DEFAULT NULL,
  primary_group VARCHAR(64) DEFAULT NULL,
  primary_grade VARCHAR(64) DEFAULT NULL,
  primary_lesson VARCHAR(128) DEFAULT NULL,
  primary_chapter VARCHAR(255) DEFAULT NULL,
  primary_subject VARCHAR(255) DEFAULT NULL,
  -- ستون‌های فاز ۲ (پاسخنامه — در فاز ۱ مقدار NULL دارند)
  answer_key_json JSON DEFAULT NULL,       -- عدد 1-مبنایی (مثلاً 1) یا آرایه ([3]) یا نقشه پاسخ زیرسوال‌ها
  answer_html MEDIUMTEXT DEFAULT NULL,     -- متن HTML پاسخ تشریحی
  answer_synced_at DATETIME DEFAULT NULL,
  -- متادیتای لرنیتو و بکاپ خام برای جلوگیری از از دست رفتن فیلدهای جدید
  lernito_version INT UNSIGNED DEFAULT NULL,
  lernito_created_by VARCHAR(64) DEFAULT NULL,
  lernito_created_at DATETIME DEFAULT NULL,
  raw_json JSON NOT NULL,
  last_synced_at DATETIME NOT NULL,
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (id),
  UNIQUE KEY uq_lernito_questions_lernito_id (lernito_id),
  KEY idx_lernito_questions_type (question_type, is_multipart),
  KEY idx_lernito_questions_lesson_grade (primary_lesson(80), primary_grade(40), difficulty),
  KEY idx_lernito_questions_group_grade (primary_group(50), primary_grade(40)),
  KEY idx_lernito_questions_answer_synced (answer_synced_at)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

CREATE TABLE IF NOT EXISTS lernito_shelf_questions (
  id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
  shelf_id BIGINT UNSIGNED NOT NULL,
  question_lernito_id VARCHAR(64) NOT NULL,
  position INT UNSIGNED NOT NULL,          -- ترتیب 0-مبنایی رکورد داخل شلف
  doc_type VARCHAR(32) NOT NULL DEFAULT 'Question',
  sub_parts_json JSON DEFAULT NULL,        -- مثلاً [0, 1, 2, 3] (اندیس‌های 0-مبنایی روی subQuestions) یا NULL
  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (id),
  UNIQUE KEY uq_lernito_shelf_pos (shelf_id, position),
  KEY idx_lernito_sq_question_id (question_lernito_id),
  KEY idx_lernito_sq_shelf_question (shelf_id, question_lernito_id),
  CONSTRAINT fk_lernito_sq_shelf
    FOREIGN KEY (shelf_id) REFERENCES lernito_shelves (id)
    ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

چرا question_lernito_id در lernito_shelf_questions کلید خارجی (FK) به lernito_questions ندارد؟
چون در چرخه Pull، ابتدا شلف‌ها و ارجاعات‌شان ذخیره می‌شوند و سپس سوالات غایب در بچ‌های ۱۰۰تایی از لرنیتو دانلود و وارد lernito_questions می‌شوند (یا ممکن است برخی شناسه‌ها در missingIds باشند). نداشتن FK مستقیم روی question_lernito_id باعث می‌شود sync کاملاً idempotent و مقاوم در برابر قطعی میان‌کار باشد، و هنگام JOIN روی lernito_questions.lernito_id از ایندکس uq_lernito_questions_lernito_id استفاده می‌شود.

۵. جدول نگاشت فیلدها و قواعد دامنه‌ای حیاتی
نگاشت فیلدهای شلف (GET /internal/shelves → lernito_shelves)
فیلد JSON لرنیتو	ستون MySQL	نکته
_id	lernito_id	کلید یکتا (معمولاً ۲۴ کاراکتر هگز MongoDB)
name (یا title)	name	اگر خالی بود ''
color	color	مثلاً "#ff9800" یا null
creatorId	creator_id	شناسه سازنده در لرنیتو
records.length	record_count	تعداد رکوردهای سطح بالا (نه تعداد زیرسوال‌ها)
dateCreated	lernito_created_at	تبدیل ISO-8601 (2026-10-02T08:12:25.854Z) به UTC Y-m-d H:i:s
dateModified	lernito_modified_at	معیار تشخیص تغییر شلف برای بازنویسی lernito_shelf_questions
نگاشت فیلدهای سوال (POST /internal/fetch-questions → lernito_questions)
فیلد JSON لرنیتو	ستون MySQL	قاعده استخراج دقیق
_id	lernito_id	کلید یکتا
subQuestions	is_multipart, sub_questions_json	اگر آرایه غیرخالی باشد is_multipart = 1
type	question_type	اگر is_multipart === 1 مقدار 'multipart'؛ در غیر این صورت doc.type ?? 'unknown'
count	part_count	is_multipart ? count(subQuestions) : (doc.count ?? 1)
difficulty	difficulty	در سوالات چندبخشی ریشه null است؛ می‌توانید doc.difficulty ?? doc.subQuestions[0].difficulty ?? null بگذارید
question	question_html	HTML خام (در سوالات چندبخشی، این متن صورت/متن مشترک یا بیت است)
choices	choices_json	فقط در سوالات تک‌بخشی وجود دارد؛ تعداد گزینه‌ها همیشه ۴ نیست (نمونه ۲-گزینه‌ای در داده واقعی وجود دارد)
topics	topics_json, primary_*	نکته حیاتی: در سوالات چندبخشی، doc.topics وجود ندارد و topics داخل هر عضو subQuestions[i] است! پس منبع مبحث اولیه: $primaryTopic = $doc['topics'][0] ?? $doc['subQuestions'][0]['topics'][0] ?? null (در اولویت‌بندی، اگر عضوی isMainTopic === true دارد همان انتخاب شود)
کل سند doc	raw_json	بدون تغییر ذخیره شود تا هیچ فیلدی از دست نرود
۵ نکته دامنه (Edge Cases) که ایجنت بک‌اند حتماً باید بداند
ترتیب فیلتر subParts و سوالات تشریحی (description):
مقادیر subParts روی رکورد شلف (مثل [0, 1, 2, 3]) اندیس‌های ۰-مبنایی روی آرایه خام subQuestions هستند.
برای آزمون‌های ۴-گزینه‌ای، همیشه باید ابتدا subParts اعمال شود و بعد از آن زیرسوال‌های با type === "description" حذف شوند (دقیقاً مطابق src/subparts.ts). در دیتابیس، داده خام و کامل ذخیره شود تا فیچرهای مختلف (آزمون تستی، آزمون تشریحی، بانک سوال) بتوانند فیلتر دلخواه خود را روی آن اعمال کنند.
ساختار answerKey در فاز ۲:
مقدار answerKey لرنیتو ۱-مبنایی (1 تا 4) است و در برخی سوالات به‌جای عدد، به شکل آرایه تک‌عضوی می‌آید (مثل [3] در نمونه واقعی 5fae5697280c0600065acb63).
در سوالات چندبخشی، کلید و پاسخ تشریحی روی هر زیرسوال (subQuestions[i].answerKey و subQuestions[i].answer) قرار می‌گیرد (مشاهده‌شده در src/pdf.ts؛ پیشنهاد می‌شود در فاز ۲ هنگام آپدیت پاسخنامه یک سوال چندبخشی، پاسخ‌های هر زیرسوال نیز در sub_questions_json یا answer_key_json ادغام شوند).
چند مبحث بودن (topics[]) و وجود subject1:
یک سوال ممکن است چند عضو در topics داشته باشد (مثل 5fae5697280c0600065acb63 که هم «حسابان یازدهم ریاضی» است و هم «ریاضی یازدهم تجربی») و علاوه بر subject0، فیلد subject1 هم داشته باشد. بنابراین ستون‌های primary_* برای کوئری سریع هستند و topics_json مرجع کامل است.
محتوای HTML، فرمول‌های KaTeX و تصاویر خارجی:
متن question، choices و answer شامل تگ‌های HTML (مثل <p dir="RTL">, &zwnj;, <img ...>), فرمول‌های LaTeX ($...$ و \[...\]) و لینک تصاویر روی سرور لرنیتو (https://api.lernito.com/lernito-public/question-images/<id>) است.
در MySQL متن خام نگهداری شود و هنگام نمایش در وب‌اپ، از HTML sanitizer ایمن (یا KaTeX auto-render) استفاده شود.
نکات فنی تأییدشده / محدودیت‌های شناخته‌شده:
دریافت سوالات با لیست ID از طریق POST /internal/fetch-questions بر پایه متد shelf/getShelfRecords بدون ارسال shelfId است. اگر شناسه‌ای در اکانت لرنیتو موجود یا قابل دسترسی نباشد، سرویس Node آن را در missingIds گزارش می‌کند؛ PHP نباید روی missingIds در حلقه بی‌نهایت بیفتد (می‌تواند پس از لاگ کردن، از آن‌ها عبور کند یا با cooldown مجدد امتحان کند).
۶. الگوی پیاده‌سازی Sync در famoapi_ai (scripts/lernito_sync.php)
مطابق ساختار موجود scripts/sms_cron.php در famoapi_ai:

گارد اجرا و قفل همزمانی:
بررسی PHP_SAPI === 'cli'، بارگذاری .env با Dotenv\Dotenv::createImmutable، و تنظیم date_default_timezone_set('UTC').
گرفتن قفل Redis با App\Core\RedisClient (مثلاً کلید lock:lernito_sync با TTL مثلاً 900 ثانیه) تا دو اجرای Cron همزمان روی هم نیفتند.
مرحله ۱ — همگام‌سازی شلف‌ها:
فراخوانی GET {LERNITO_SERVICE_URL}/internal/shelves?force=1 با هدر X-Internal-Key: {LERNITO_INTERNAL_KEY} (تایم‌اوت ۴۵ ثانیه).
برای هر شلف در data.shelves:
بررسی lernito_modified_at فعلی در lernito_shelves.
Upsert شلف در lernito_shelves.
اگر شلف جدید است یا lernito_modified_at تغییر کرده (یا --force-links داده شده)، داخل یک تراکنش MySQL رکوردهای lernito_shelf_questions آن شلف را با آرایه جدید records جایگزین کنید (DELETE + batch INSERT با حفظ position و sub_parts_json).
مرحله ۲ — کشف و دانلود سوالات جدید (Incremental):
کوئری SQL برای یافتن شناسه‌های غایب:
SELECT DISTINCT sq.question_lernito_id
FROM lernito_shelf_questions sq
LEFT JOIN lernito_questions q ON q.lernito_id = sq.question_lernito_id
WHERE q.id IS NULL
LIMIT 500;

تقسیم لیست به بچ‌های 100 تایی و فراخوانی POST {LERNITO_SERVICE_URL}/internal/fetch-questions با مکث 300–500ms بین هر بچ.
Upsert تمام اسناد برگشتی data.questions در lernito_questions (همه کوئری‌ها با Prepared Statements در PDO).
ثبت لاگ خلاصه در خروجی CLI: تعداد شلف‌ها، تعداد سوالات جدید دانلودشده، تعداد missingIds.
زمان‌بندی پیشنهادی Crontab:
بار اول (Backfill ~10,871 سوال یکتا): اجرای دستی با پرچم --max-questions=15000 (~۱۱۰ بچ ۱۰۰تایی، مجموعاً حدود ۲ تا ۴ دقیقه).
اجرای عادی دوره‌ای: هر ۱۵ یا ۳۰ دقیقه یک‌بار (*/15 * * * * php /path/to/famoapi_ai/scripts/lernito_sync.php).
مسیر توسعه فاز ۲ (پاسخنامه‌ها):
بدون هیچ مایگریشن جدیدی، اسکریپت می‌تواند شلف‌هایی را که سوال‌هایشان answer_synced_at IS NULL دارند پیدا کرده و GET /internal/shelves/{lernito_id}/answers را صدا بزند و ستون‌های answer_key_json، answer_html و answer_synced_at را پر کند.